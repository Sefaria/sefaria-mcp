SEFARIA_API_BASE_URL=https://www.sefaria.org
SEFARIA_AI_BASE_URL=https://ai.sefaria.org

# HTTP server (both /mcp and /sse are served on this port)
SEFARIA_MCP_PORT=8088
SEFARIA_MCP_METRICS_PORT=9090

# Host/Origin allowlists for the Streamable HTTP endpoint (/mcp).
# Comma-separated. Loopback hosts are always allowed.
# SEFARIA_MCP_ALLOWED_HOSTS=mcp.sefaria.org,devmcp.sefaria.org
# SEFARIA_MCP_ALLOWED_ORIGINS=https://mcp.sefaria.org,https://devmcp.sefaria.org
# Set to "off" to disable Host/Origin validation entirely.
# SEFARIA_MCP_HOST_PROTECTION=on
